{
  "name": "dsh-reactor",
  "version": "0.2.0",
  "description": "Event-Condition-Action (ECA) rule engine for DeepSeek Harness: turn your agent from a passive responder into an active watchdog that watches event sources, evaluates conditions, and executes actions automatically. v0.2 adds persistent rules, real agent sessions, execution history, and a webhook push ingress.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "execa": "^9.5.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^26.5.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "automation",
    "event-driven",
    "eca",
    "rule-engine",
    "scheduler",
    "watchdog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/snhna-a/dsh-reactor.git"
  }
}
